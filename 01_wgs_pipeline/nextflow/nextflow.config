// nextflow.config — Profiles: local, slurm, aws
manifest {
  name        = 'ngs-mapping-and-analysis'
  description = 'WGS Alignment Pipeline'
  version     = '2.0.0'
  author      = 'yerpopek-cmyk'
  nextflowVersion = '>=23.04.0'
}

params {
  help       = false
  reads      = "data/*_{R1,R2}*.fastq.gz"
  reference  = "reference/genome.fa"
  outdir     = "results"
  threads    = 8
  remove_dups= false
  bed        = ""
}

profiles {
  // ── Local execution ─────────────────────────────────
  local {
    process.executor = 'local'
    docker.enabled   = true
    process {
      cpus   = 8
      memory = '32 GB'
      time   = '12h'
    }
  }

  local_native {
    process.executor = 'local'
    docker.enabled   = false
    process {
      cpus   = 4
      memory = '8 GB'
      time   = '2h'
    }
  }

  // ── SLURM HPC ────────────────────────────────────────
  slurm {
    process.executor = 'slurm'
    singularity.enabled = true
    singularity.autoMounts = true
    process {
      queue  = 'normal'
      cpus   = 16
      memory = '64 GB'
      time   = '24h'
      clusterOptions = '--account=YOUR_ACCOUNT'
    }
    executor {
      queueSize    = 50
      pollInterval = '30 sec'
    }
  }

  // ── AWS Batch ────────────────────────────────────────
  aws {
    process.executor  = 'awsbatch'
    aws.region        = 'us-east-1'
    aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
    process {
      queue  = 'YOUR_BATCH_QUEUE'
      cpus   = 16
      memory = '64 GB'
    }
    docker.enabled = true
  }

  // ── Test (CI) ────────────────────────────────────────
  test {
    process.executor = 'local'
    docker.enabled   = true
    params {
      reads     = "${projectDir}/test/data/*_{R1,R2}*.fastq.gz"
      reference = "${projectDir}/test/data/chr22_small.fa"
      outdir    = "${projectDir}/test/results"
      threads   = 2
    }
    process {
      cpus   = 2
      memory = '8 GB'
      time   = '2h'
    }
  }
}

// ── Reporting ─────────────────────────────────────────
report {
  enabled = true
  file    = "${params.outdir}/pipeline_report.html"
}

timeline {
  enabled = true
  file    = "${params.outdir}/pipeline_timeline.html"
}

trace {
  enabled = true
  file    = "${params.outdir}/pipeline_trace.txt"
  fields  = 'task_id,name,status,exit,realtime,%cpu,rss'
}
